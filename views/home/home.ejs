<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>WanderLust</title>
      <link rel="stylesheet" href="/css/style.css" />
      <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
      />
      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
      />
    </head>
  </head>
  <body>
    <nav class="navbar navbar-expand-md bg-white shadow-sm sticky-top py-3">
      <div
        class="container-fluid d-flex justify-content-between align-items-center"
      >
        <!-- Left Logo -->
        <a class="navbar-brand fw-bold text-danger fs-4" href="/">
          <i class="fa-solid fa-compass"></i> WanderLust
        </a>

        <!-- Right Menu -->
        <div class="d-flex align-items-center gap-3">
          <!-- User Menu -->
          <div class="dropdown">
            <button
              class="btn border rounded-pill px-3 py-2 d-flex align-items-center gap-2"
              data-bs-toggle="dropdown"
            >
              <i class="fa-solid fa-bars"></i>
              <i class="fa-solid fa-user-circle fs-5"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
              <li><a class="dropdown-item" href="/">Home</a></li>
              <li><a class="dropdown-item" href="/profile">Profile</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item text-danger" href="/login">Login</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </nav>

    <section
      id="hero"
      class="hero-section d-flex align-items-center justify-content-center text-center"
    >
      <div class="container text-dark">
        <h1 class="display-3 fw-bold mb-4">
          Welcome to <span>WanderLust</span>
        </h1>
        <p class="lead mb-4">
          Discover amazing stays and unique experiences around the world.
        </p>
        <a
          href="/listings"
          class="btn btn-lg btn-outline-danger fw-bold px-5 py-3 register-btn"
        >
          Explore Now
        </a>
      </div>
    </section>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
    <script src="/js/script.js"></script>
  </body>
</html>

<% layout("/layouts/boilerplate") %>
<body>
  <div class="auth-wrapper">
    <div class="auth-signup-box">
      <% if (error && error.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= error[0] %>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="alert"
          aria-label="Close"
        ></button>
      </div>
      <% } %>
      <h1 class="auth-title">Create Account</h1>
      <!-- Added needs-validation and novalidate -->
      <form
        action="/signup"
        method="POST"
        class="auth-form needs-validation"
        novalidate
      >
        <div class="auth-field">
          <label class="auth-label" for="username">Username</label>
          <input
            type="text"
            id="username"
            name="username"
            placeholder="Enter your username"
            class="auth-input"
            required
          />
          <!-- Bootstrap invalid feedback -->
          <div class="invalid-feedback">Please enter a username.</div>
          <div class="valid-feedback">Looks good!</div>
        </div>

        <div class="auth-field">
          <label class="auth-label" for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            class="auth-input"
            required
          />
          <div class="invalid-feedback">Please enter a valid email.</div>
          <div class="valid-feedback">Correct!</div>
        </div>

        <div class="auth-field">
          <label class="auth-label" for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Create a password"
            class="auth-input"
            required
            minlength="6"
          />
          <div class="invalid-feedback">
            Password must be at least 6 characters.
          </div>
          <div class="valid-feedback">Strong password!</div>
        </div>

        <button type="submit" class="auth-btn">Sign Up</button>

        <p class="auth-link-box">
          Already have an account?
          <a href="/login" class="auth-link">Login here</a>
        </p>
      </form>
    </div>
  </div>
</body>

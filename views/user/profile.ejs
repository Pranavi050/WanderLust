<% layout("/layouts/boilerplate") %>
<body class="bg-light">
  <div class="container py-5">
    <div
      class="card shadow-sm mx-auto p-4"
      style="max-width: 700px; border-radius: 20px"
    >
      <div class="d-flex align-items-center flex-wrap">
        <% const profileImage = user && user.image ? user.image :
        '/images/profile.jpg'; %>

        <!-- Profile Image -->
        <div class="me-4 mb-3 mb-md-0">
          <img
            src="<%= profileImage %>"
            alt="Profile"
            class="rounded-circle"
            style="width: 130px; height: 130px; object-fit: cover"
          />
        </div>

        <!-- User Info -->
        <div>
          <h3 class="mb-1"><%= user ? user.username : 'Unknown' %></h3>
          <p class="text-muted mb-2">
            <%= user && user.email ? user.email : 'No email' %>
          </p>
          <p class="text-secondary mb-0">
            <%= user && user.bio ? user.bio : 'No bio added yet.' %>
          </p>
        </div>
      </div>

      <hr class="my-4" />

      <div class="text-center">
        <a href="/logout" class="btn btn-outline-danger">Logout</a>
      </div>
    </div>
  </div>
</body>
